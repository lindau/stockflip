<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.StockFlip.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:id="@+id/tickerInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Aktie eller kryptovaluta">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/tickerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/contextText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="Välj antal dagar för det glidande medelvärdet (SMA)."
        tools:text="Aktuellt pris är 245,50 SEK. Välj antal dagar för SMA:t." />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/presetChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/presetChipOne"
            style="@style/Widget.StockFlip.AssistChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20 dagar" />

        <com.google.android.material.chip.Chip
            android:id="@+id/presetChipTwo"
            style="@style/Widget.StockFlip.AssistChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50 dagar" />

        <com.google.android.material.chip.Chip
            android:id="@+id/presetChipThree"
            style="@style/Widget.StockFlip.AssistChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100 dagar" />

        <com.google.android.material.chip.Chip
            android:id="@+id/presetChipFour"
            style="@style/Widget.StockFlip.AssistChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="200 dagar" />

    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.StockFlip.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Antal dagar (SMA-period)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/periodInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/triggerInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="När priset passerar SMA:t markeras larmet som utlöst (engångslarm)." />

</LinearLayout>
